name = "moonbitstack/moonapi"

version = "0.17.8"

readme = "README.md"

source = "src"

repository = "https://github.com/moonbitstack/moonapi"

license = "Apache-2.0"

keywords = [
  "web",
  "web-framework",
  "framework",
  "http",
  "rest",
  "rest-api",
  "api",
  "openapi",
  "swagger",
  "redoc",
  "json-schema",
  "routing",
  "router",
  "dependency-injection",
  "validation",
  "websocket",
  "sse",
  "static-files",
  "templates",
  "cors",
  "gzip",
  "security",
  "oauth2",
  "jwt",
  "api-key",
  "basic-auth",
  "bearer",
  "annotations",
  "async",
  "asgi",
  "fastapi",
  "moonbit",
]

description = "A typed web framework for MoonBit."

import {
  "moonbitlang/async@0.22.5",
  "moonbitlang/parser@0.4.6",
  "moonbitstack/moonasgi@0.10.4",
  "moonbitstack/moonast@0.2.3",
  "moonbitstack/moonbase@0.4.2",
  "moonbitstack/mooncred@0.6.7",
  "moonbitstack/mooncrypt@0.4.6",
  "moonbitstack/moondate@0.1.0",
  "moonbitstack/moonhttp@0.15.3",
  "moonbitstack/moonjson@0.4.2",
  "moonbitstack/moonmime@0.2.1",
  "moonbitstack/moonmodel@0.1.0",
  "moonbitstack/moonpug@0.1.2",
  "moonbitstack/moonregex@0.1.2",
  "moonbitstack/moonschema@0.2.2",
  "moonbitstack/moonurl@0.2.3",
  "moonbitstack/moonzip@0.3.2",
}
