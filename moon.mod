  "framework",
  "http",
  "rest",
  "rest-api",
  "api",
  "openapi",
  "openapi3",
  "swagger",
  "swagger-ui",
  "redoc",
  "redocly",
  "scalar",
  "api-reference",
  "documentation",
  "json-schema",
  "routing",
  "router",
  "dependency-injection",
  "validation",
  "websocket",
  "sse",
  "static-files",
  "templates",
  "cors",
  "gzip",
  "security",
  "oauth2",
  "jwt",
  "api-key",
  "basic-auth",
  "bearer",
  "annotations",
  "async",
  "asgi",
  "mcp",
  "model-context-protocol",
  "ai-agent",
  "agent-skills",
  "skill",
  "fastapi",
  "moonbit",
]

description = "A typed web framework for MoonBit."

import {
