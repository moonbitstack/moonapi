name = "moonbitstack/moonapi-ecosystem"

version = "0.1.0"

readme = "README.md"

repository = "https://github.com/moonbitstack/moonapi"

license = "Apache-2.0"

keywords = [ "moonapi", "moonorm", "moonmodel", "sqlite", "example", "moonbit" ]

description = "A full service, and one description of a task driving moonapi's validation and document, and moonorm's table and rows."

import {
  "moonbitlang/async@0.22.5",
  "moonbitstack/moonapi@0.18.1",
  "moonbitstack/moonasgi@0.11.2",
  "moonbitstack/mooncat@0.21.0",
  "moonbitstack/moondb@0.3.0",
  "moonbitstack/moonhttp@0.16.0",
  "moonbitstack/moonjson@0.5.0",
  "moonbitstack/moonmcp@0.2.0",
  "moonbitstack/moonmodel@0.2.0",
  "moonbitstack/moonorm@0.12.0",
  "moonbitstack/moonsqlite@0.4.0",
}

source = "src"
