name = "moonbitstack/moonapi-ecosystem"

version = "0.1.0"

readme = "README.md"

repository = "https://github.com/moonbitstack/moonapi"

license = "Apache-2.0"

keywords = [ "moonapi", "moonorm", "moonmodel", "sqlite", "example", "moonbit" ]

description = "A full service, and one description of a task driving moonapi's validation and document, and moonorm's table and rows."

import {
  "moonbitlang/async@0.22.5",
  "moonbitstack/moonapi@0.17.8",
  "moonbitstack/moonasgi@0.10.6",
  "moonbitstack/mooncat@0.19.5",
  "moonbitstack/moondb@0.2.6",
  "moonbitstack/moonhttp@0.15.8",
  "moonbitstack/moonjson@0.4.4",
  "moonbitstack/moonmcp@0.1.12",
  "moonbitstack/moonmodel@0.1.3",
  "moonbitstack/moonorm@0.11.7",
  "moonbitstack/moonsqlite@0.3.5",
}

source = "src"
