// Drives the same requests at all three registrations and fails when they answer
// differently.
import {
  "moonbitstack/moonapi",
  "moonbitstack/moonasgi",
  "moonbitstack/moonapi-ecosystem/shared",
  "moonbitstack/moonapi-ecosystem/ann",
  "moonbitstack/moonapi-ecosystem/fns",
  "moonbitstack/moonapi-ecosystem/cls",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/async",
}

supported_targets = "native"

pkgtype(kind: "executable")
