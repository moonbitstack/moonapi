///|
fn generate(source : String) -> String raise {
  @gen.render(Routes::{ }, [("users.mbt", source)])
}

///|
test "each verb registers its handler on the app" {
  let source =
    #|#app.get("/users/{id}", summary="Get a user", tags="users", tags="read")
    #|pub fn get_user(ctx : @moonapi.Context) -> @moonasgi.Response raise {
    #|  ignore(ctx)
    #|  @moonapi.text(200, "user")
    #|}
    #|
    #|#app.post("/users", status_code="201", deprecated=true)
    #|fn create_user(ctx : @moonapi.Context) -> @moonasgi.Response raise {
    #|  ignore(ctx)
    #|  @moonapi.text(201, "created")
    #|}
  inspect(
    generate(source),
    content=(
      #|// Generated by moonapi routes from users.mbt. Edit those files, not this one.
      #|
      #|///|
      #|pub fn register(app : @moonapi.App) -> Unit {
      #|  app.route(
      #|    Get,
      #|    "/users/{id}",
      #|    ctx => get_user(ctx),
      #|    summary="Get a user",
      #|    tags=["users", "read"],
      #|  )
      #|  app.route(
      #|    Post,
      #|    "/users",
      #|    ctx => create_user(ctx),
      #|    deprecated=true,
      #|    status_code=201,
      #|  )
      #|}
      #|
    ),
  )
}

///|
test "a route names any method, an extension one as Other" {
  let source =
    #|#app.route("PURGE", "/cache")
    #|fn purge(ctx : @moonapi.Context) -> @moonasgi.Response raise {
    #|  ignore(ctx)
    #|  @moonapi.text(200, "purged")
    #|}
    #|
    #|#app.route("TRACE", "/echo")
    #|fn echo(ctx : @moonapi.Context) -> @moonasgi.Response raise {
    #|  ignore(ctx)
    #|  @moonapi.text(200, "echo")
    #|}
  let code = generate(source)
  assert_eq(
    code.contains("app.route(Other(\"PURGE\"), \"/cache\", ctx => purge(ctx))"),
    true,
  )
  assert_eq(
    code.contains("app.route(Trace, \"/echo\", ctx => echo(ctx))"),
    true,
  )
}

///|
test "a websocket annotation takes a name and dependencies" {
  let source =
    #|#app.websocket("/room/{id}", name="room", dependencies="db", dependencies="auth")
    #|async fn room(ws : @moonapi.WebSocket) -> Unit {
    #|  ignore(ws)
    #|}
  let code = generate(source)
  assert_eq(
    code.contains("app.websocket(") &&
    code.contains("ws => room(ws),") &&
    code.contains("name=\"room\",") &&
    code.contains("dependencies=[\"db\", \"auth\"]"),
    true,
  )
}

///|
test "router annotations go to register_router, websockets and shapes too" {
  let source =
    #|#router.put("/items/{id}")
    #|fn put_item(ctx : @moonapi.Context, tasks : @moonapi.BackgroundTasks) -> @moonasgi.Response raise {
    #|  ignore((ctx, tasks))
    #|  @moonapi.text(200, "ok")
    #|}
    #|
    #|#router.get("/feed")
    #|fn feed(ctx : @moonapi.Context) -> @moonapi.Stream {
    #|  ignore(ctx)
    #|  abort("")
    #|}
    #|
    #|#app.websocket("/ws")
    #|fn chat(ws : @moonapi.WebSocket) -> Unit {
    #|  ignore(ws)
    #|}
  let code = generate(source)
  assert_eq(
    code.contains("pub fn register(app : @moonapi.App) -> Unit {"),
    true,
  )
  assert_eq(code.contains("app.websocket(\"/ws\", ws => chat(ws))"), true)
  assert_eq(
    code.contains("pub fn register_router(router : @moonapi.Router) -> Unit {"),
    true,
  )
  assert_eq(
    code.contains("ctx => put_item(ctx, ctx.background)") &&
    code.contains("router.route("),
    true,
  )
  assert_eq(
    code.contains("router.route_stream(Get, \"/feed\", ctx => feed(ctx))"),
    true,
  )
}

///|
test "nothing annotated, nothing generated" {
  let source =
    #|fn helper() -> Int32 {
    #|  1
    #|}
  inspect(
    generate(source),
    content=(
      #|// Generated by moonapi routes from users.mbt. Edit those files, not this one.
      #|
      #|
    ),
  )
}

///|
test "mistakes are refused with where they are" {
  let cases = [
    (
      "#app.route(\"BAD METHOD\", \"/x\")\nfn x(ctx : @moonapi.Context) -> @moonasgi.Response raise { abort(\"\") }\n",
      "users.mbt:1:", "not a method name",
    ),
    (
      "#app.get(\"/x\", status_code=\"two\")\nfn x(ctx : @moonapi.Context) -> @moonasgi.Response raise { abort(\"\") }\n",
      "users.mbt:1:", "status_code",
    ),
    (
      "#app.fetch(\"/x\")\nfn x(ctx : @moonapi.Context) -> @moonasgi.Response raise { abort(\"\") }\n",
      "users.mbt:1:", "not a route annotation",
    ),
    (
      "#app.get(\"/x\")\npub(all) struct S {}\n", "users.mbt:1:", "free function",
    ),
    (
      "#app.get(\"/x\")\nfn S::x(self : S) -> Unit { ignore(self) }\n", "users.mbt:1:",
      "free function",
    ),
  ]
  for case in cases {
    let (source, place, words) = case
    let message = try generate(source) catch {
      e => e.to_string()
    } noraise {
      _ => fail("accepted: " + source)
    }
    assert_eq(message.contains(place), true, msg=message)
    assert_eq(message.contains(words), true, msg=message)
  }
}
