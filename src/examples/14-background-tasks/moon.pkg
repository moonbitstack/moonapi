import {
  "moonbitlang/async",
  "moonbitstack/moonapi",
  "moonbitstack/moonasgi",
  "moonbitstack/moonasgi/mid",
  "moonbitlang/core/encoding/utf8",
}

pkgtype(kind: "executable")

warnings = "-29"

options(
  targets: {
    "main.mbt": [ "native", "wasm", "js" ],
    "elsewhere.mbt": [ "wasm-gc" ],
  },
)
