///|
pub fn register(app : @moonapi.App) -> Unit {
  app.route(
    Get,
    "/items/{id}",
    ctx => read_item(ctx),
    summary="Read an item",
    tags=["items"],
  )
  app.route(
    Post,
    "/items",
    ctx => create_item(ctx),
    tags=["items"],
    status_code=201,
  )
  app.route(Delete, "/items/{id}", ctx => delete_item(ctx), tags=["items"])
  app.route(
    Other("PURGE"),
    "/cache",
    ctx => purge(ctx),
    summary="Drop the cache",
  )
}

///|
pub fn register_router(router : @moonapi.Router) -> Unit {
  router.route(Get, "/me", ctx => me(ctx))
}
