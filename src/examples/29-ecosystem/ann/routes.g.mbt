pub fn register(app : @moonapi.App) -> Unit {
  app.route(
    Get,
    "/tasks",
    ctx => list_tasks(ctx),
    summary="Every task",
    tags=["tasks"],
    name="list_tasks",
  )
  app.route(
    Post,
    "/tasks",
    ctx => create_task(ctx),
    summary="Add a task",
    tags=["tasks"],
    status_code=201,
    name="create_task",
  )
  app.route(
    Get,
    "/tasks/{id:int}",
    ctx => get_task(ctx),
    summary="One task",
    tags=["tasks"],
    name="get_task",
  )
  app.route(
    Delete,
    "/tasks/{id:int}",
    ctx => delete_task(ctx),
    summary="Remove a task",
    tags=["tasks"],
    name="delete_task",
  )
