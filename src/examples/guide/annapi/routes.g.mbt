pub fn register(app : @moonapi.App) -> Unit {
  app.route(
    Get,
    "/ping",
    ctx => ping(ctx),
    summary="Health check",
    tags=["misc"],
  )
  app.route(Post, "/echo", ctx => echo(ctx), summary="Echo", tags=["misc"])
}
