// Routes written as annotations, FastAPI's way: `moon run examples/27-annotations`.
// `routes.g.mbt` comes from `cmd/routes`; a project wires it as a dev_build rule.
import {
  "moonbitstack/moonapi",
  "moonbitstack/moonasgi",
  "moonbitlang/core/encoding/utf8",
}

pkgtype(kind: "executable")

formatter(ignore: [ "routes.g.mbt" ])
